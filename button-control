#include <Arduino.h>

void setup() {
  pinMode(2, INPUT);  // SET PIN 2 AS INPUT
  pinMode(3, OUTPUT);  // SET PIN 3 AS OUTPUT (LED)
}

void loop() {
  int button = digitalRead(2);  // READ BUTTON STATE (HIGH OR LOW) 

  if (button == HIGH) {
    digitalWrite(3, HIGH); // Turn LED ON if button is pressed
  } else {
    digitalWrite(3, LOW); // Turn LED OFF if button is not pressed
  }
}
